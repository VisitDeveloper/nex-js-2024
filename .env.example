NEXT_PUBLIC_BASE_API_URL_CLIENT=http://localhost:1337/api
NEXT_PUBLIC_BASE_API_URL_SERVER=http://localhost:1337
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Seconds to wait after confirming a delete before calling the API (undo window). Default 10; max 300.
NEXT_PUBLIC_DELETE_UNDO_SECONDS=10

# Used to sign the OutSideJWT session cookie (must match across deploys).
JWT_SECRET=replace-with-long-random-string

STRAPI_API_URL=http://localhost:1337
# Used by server routes (e.g. Stripe webhook, discount code validation). Dashboard CRUD uses the staff Strapi JWT from login (cookie bw_strapi_jwt).
STRAPI_API_TOKEN=replace-with-strapi-api-token

# Copy to .env and set real values (never commit .env). Use Stripe Dashboard test keys in development.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret

# Same random string in brainwave-strapi .env (Stripe webhook → transition + payment rows)
BRAINWAVE_CHECKOUT_WEBHOOK_SECRET=

# hCaptcha — login captcha (https://dashboard.hcaptcha.com/)
# Set both to enforce verification on POST /api/login. Omit in local dev if you skip captcha.
